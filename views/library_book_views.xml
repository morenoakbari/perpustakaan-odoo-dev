<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW (DITAMBAHKAN THUMBNAIL) -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'dipinjam'" decoration-success="status == 'tersedia'">
                <field name="image_cover_thumbnail" widget="image" class="oe_avatar"/>
                <field name="name" string="Judul Buku"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="tahun_terbit"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <!-- FORM VIEW (DITAMBAHKAN AREA UNTUK GAMBAR) -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <!-- HEADER INFO -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Judul Buku"/>
                        </h1>
                    </div>

                    <group>
                        <!-- KOLOM KIRI -->
                        <group>
                            <field name="author"/>
                            <field name="isbn"/>
                            <field name="tahun_terbit"/>
                            <field name="jumlah_halaman"/>

                            <field name="status" widget="statusbar" decoration-danger="status == 'dipinjam'" decoration-success="status == 'tersedia'"/>
                        </group>

                        <!-- KOLOM KANAN -->
                        <group string="Cover Buku">
                            <field name="image_cover" widget="image" class="oe_avatar" options='{"preview_image": "image_cover_thumbnail"}'/>
                            <field name="image_cover_thumbnail" invisible="1"/>

                            <p class="text-muted">
                                <small>JPG / PNG • Maks 1024x1024</small>
                            </p>
                        </group>
                    </group>

                    <notebook>
                        <page string="📖 Sinopsis">
                            <field name="sinopsis" nolabel="1"/>
                        </page>

                        <page string="📚 Riwayat Peminjaman">
                            <field name="loan_ids" readonly="1">
                                <list decoration-danger="state == 'borrowed'">
                                    <field name="name"/>
                                    <field name="borrower_name"/>
                                    <field name="borrow_date"/>
                                    <field name="return_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


</odoo>